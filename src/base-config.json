{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "warn",
    "timestamp": true
  },
  "http_clients": [
    {
      "tag": "rule-set-proxy",
      "detour": "Proxy"
    }
  ],
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "system-dns"
      },
      {
        "type": "tcp",
        "tag": "alidns-1",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "type": "tcp",
        "tag": "alidns-2",
        "server": "223.6.6.6",
        "server_port": 53
      },
      {
        "type": "https",
        "tag": "cloudflare-dns",
        "server": "1.1.1.1",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        },
        "detour": "Proxy"
      },
      {
        "type": "tailscale",
        "tag": "tailscale-dns",
        "endpoint": "Tailscale",
        "accept_default_resolvers": false,
        "accept_search_domain": true
      }
    ],
    "rules": [
      {
        "preferred_by": "tailscale-dns",
        "action": "route",
        "server": "tailscale-dns"
      },
      {
        "query_type": [
          "AAAA"
        ],
        "rule_set": [
          "geosite-douyin",
          "geosite-fqnovel",
          "geosite-cn"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "domain_suffix": [
          "taobao.com",
          "jd.com",
          "aliyun.com",
          "apple.com.cn",
          "icloud.com.cn"
        ],
        "action": "route",
        "server": "alidns-1"
      },
      {
        "rule_set": [
          "geosite-douyin",
          "geosite-fqnovel"
        ],
        "action": "route",
        "server": "alidns-1"
      },
      {
        "rule_set": [
          "geosite-category-ai-chat-!cn",
          "geosite-openai",
          "geosite-anthropic",
          "geosite-google-gemini",
          "geosite-perplexity",
          "geosite-github-copilot",
          "geosite-cursor",
          "geosite-jetbrains-ai",
          "geosite-xai",
          "geosite-apple-intelligence",
          "geosite-tiktok",
          "geosite-apple",
          "geosite-youtube",
          "geosite-netflix",
          "geosite-telegram",
          "geosite-geolocation-!cn"
        ],
        "action": "route",
        "server": "cloudflare-dns"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "action": "route",
        "server": "alidns-1"
      }
    ],
    "final": "system-dns",
    "strategy": "ipv4_only",
    "cache_capacity": 4096,
    "timeout": "10s"
  },
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "Tailscale",
      "state_directory": "tailscale",
      "accept_routes": true,
      "system_interface": false
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30"
      ],
      "mtu": 9000,
      "dns_mode": "hijack",
      "udp_mapping": "address_and_port_dependent",
      "auto_route": true,
